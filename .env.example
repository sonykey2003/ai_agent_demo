# ---- Provider selection -------------------------------------------------
# openai | nim | local | local_gemma
LLM_PROVIDER=local
TEMPERATURE=0.2
# Cap response length (stops runaway/looping generations).
MAX_TOKENS=1024
# Penalty to discourage repetition loops (0 disables).
FREQUENCY_PENALTY=0.3

# ---- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- NVIDIA NIM (hosted catalog or self-hosted microservice) ------------
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=deepseek-ai/deepseek-r1

# ---- Local tiny model via Ollama ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:0.5b
OLLAMA_GEMMA_MODEL=gemma4:latest

# ---- Retrieval-augmented generation (PostgreSQL + pgvector) ------------
RAG_ENABLED=true
# Port 5433 avoids conflicting with the golden demo's PostgreSQL on 5432.
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5433/vectordb
RAG_COLLECTION=ai_agent_demo_knowledge
# Embeddings use Ollama's native API, not the OpenAI-compatible /v1 endpoint.
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.45
# Backend startup waits for pgvector/Ollama, but never serves without RAG ready.
RAG_STARTUP_ATTEMPTS=60
RAG_STARTUP_RETRY_SECONDS=5

# ---- Vendor-neutral OpenTelemetry ---------------------------------------
# App always exports to a local Collector; the Collector decides the backend(s).
# Set TELEMETRY_ENABLED=false for bare local runs without a Collector.
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agent-chat-demo
DEPLOYMENT_ENVIRONMENT=demo
# Mask email, phone, and SSN patterns in span/event attributes before OTLP export.
# This does not redact application stdout logs.
OTEL_REDACT_PII=true

# Ask compatible OpenAI-style endpoints to include token usage in the final
# streaming chunk. Set false if an endpoint rejects stream_options.include_usage.
LLM_STREAM_USAGE=true

# ---- Galileo backend (read by the OTel Collector, not the app) ----------
# The Collector routes the app's OpenInference spans to Galileo. Get a key from
# your Galileo console: Settings -> API Keys.
GALILEO_API_KEY=<your_api_key>
GALILEO_PROJECT=<your_project_name>
GALILEO_LOG_STREAM=default
# OTLP ingest URL = your console host with `console`->`api`, then /otel/traces:
#   default cloud      ->  https://api.galileo.ai/otel/traces
#   multitenant cloud  ->  https://api.multitenant.galileocloud.io/otel/traces
GALILEO_OTEL_ENDPOINT=https://api.galileo.ai/otel/traces

# ---- Langfuse backend (Langfuse Cloud; comparison workstream) -----------------
# A second observability backend, toggled WITHOUT any app code change. Pick a
# Collector config, then run scripts/up.sh (or docker compose up -d):
#   OTEL_COLLECTOR_CONFIG options:
#     otel-collector.yaml           -> Galileo only (default)
#     otel-collector.langfuse.yaml  -> Langfuse only
#     otel-collector.fanout.yaml    -> BOTH at once (side-by-side comparison)
# Leave it unset for the default Galileo-only path.
# OTEL_COLLECTOR_CONFIG=otel-collector.fanout.yaml
#
# Langfuse Cloud OTLP endpoint (exporter appends /v1/traces). Regions:
#   US: https://us.cloud.langfuse.com/api/public/otel
#   EU: https://cloud.langfuse.com/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel
# Basic-auth header per domain (all point to one project here; use per-domain
# projects to mirror Galileo's per-domain log streams). Encode each key pair:
#   echo -n "pk-lf-...:sk-lf-..." | base64   # paste the result after "Basic "
LANGFUSE_AUTH_PLATFORM=Basic REPLACE_WITH_CLOUD_BASE64
LANGFUSE_AUTH_DEFAULT=Basic REPLACE_WITH_CLOUD_BASE64
LANGFUSE_AUTH_BANK=Basic REPLACE_WITH_CLOUD_BASE64
LANGFUSE_AUTH_HEALTHCARE=Basic REPLACE_WITH_CLOUD_BASE64
LANGFUSE_AUTH_INSURANCE=Basic REPLACE_WITH_CLOUD_BASE64
LANGFUSE_AUTH_RESTAURANT=Basic REPLACE_WITH_CLOUD_BASE64

# ---- Galileo metric-setup helper only (eval/configure_galileo_metrics.py) -----
# These are NOT read by the app or the Collector. They let the helper script
# register custom RAG judge metrics scored by your own model, because Galileo's
# built-in RAG metrics are pinned to the gpt-4.1-mini scorer (needs OpenAI).
# Console URL of your Galileo tenant (used by the Galileo SDK):
#   default cloud      ->  https://app.galileo.ai
#   multitenant cloud  ->  https://console.multitenant.galileocloud.io
GALILEO_CONSOLE_URL=https://app.galileo.ai
# Exact model alias to use as the metric judge (from Settings -> Integrations):
GALILEO_JUDGE_MODEL=moonshotai/kimi-k2.6
